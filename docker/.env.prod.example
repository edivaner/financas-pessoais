# ── Postgres ──────────────────────────────────────────────
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA

# ── Laravel ───────────────────────────────────────────────
APP_NAME="Finanças Pessoais"
APP_ENV=production
APP_KEY=                          # gerado com: php artisan key:generate --show
APP_DEBUG=false
APP_URL=http://SEU_IP_OU_DOMINIO

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=finance
DB_USERNAME=finance
DB_PASSWORD=TROQUE_ESTA_SENHA

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

CORS_ALLOWED_ORIGINS=http://SEU_IP_OU_DOMINIO

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@financas.local"
MAIL_FROM_NAME="Finanças Pessoais"
